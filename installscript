#!/bin/bash

# Hide "last login" line when starting a new terminal session
touch $HOME/.hushlogin

echo 'Install Homebrew packages'
echo '-------------------------'
brew bundle --file=$HOME/.dotfiles/Brewfile

# Install zsh
echo 'Install oh-my-zsh'
echo '-----------------'
rm -rf $HOME/.oh-my-zsh
RUNZSH=no KEEP_ZSHRC=yes sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"

# Symlink git prefs (machine-specific settings go into ~/.gitconfig.local)
ln -s $HOME/.dotfiles/shell/.global-gitignore $HOME/.global-gitignore
rm $HOME/.gitconfig
ln -s $HOME/.dotfiles/shell/.gitconfig $HOME/.gitconfig

# Symlink zsh prefs
rm $HOME/.zshrc
ln -s $HOME/.dotfiles/shell/.zshrc $HOME/.zshrc

# Symlink vim prefs
rm $HOME/.vimrc
ln -s $HOME/.dotfiles/shell/.vimrc $HOME/.vimrc
rm $HOME/.vim
ln -s $HOME/.dotfiles/shell/.vim $HOME/.vim

# Symlink app configs
for f in gh/config.yml ccstatusline/settings.json btop/btop.conf; do
  mkdir -p "$HOME/.config/$(dirname $f)"
  ln -sf "$HOME/.dotfiles/config/$f" "$HOME/.config/$f"
done

# Symlink Claude Code settings and personal skills
mkdir -p $HOME/.claude/skills
ln -sf $HOME/.dotfiles/claude/settings.json $HOME/.claude/settings.json
for skill in $HOME/.dotfiles/claude/skills/*; do
  ln -sfn "$skill" "$HOME/.claude/skills/$(basename "$skill")"
done

# Activate z
cd ~/.dotfiles/shell
chmod +x z.sh

echo 'Configure npm'
echo '-------------'
# Create a directory for global packages and tell npm where to store globally installed packages
mkdir "${HOME}/.npm-packages"
npm config set prefix "${HOME}/.npm-packages"

echo 'Install gitmoji-cli'
echo '-------------------'
npm i -g gitmoji-cli

echo 'Install agent-browser'
echo '---------------------'
npm i -g agent-browser

echo 'Install typescript'
echo '------------------'
npm i -g typescript

echo 'Install @kaitranntt/ccs'
echo '-----------------------'
npm i -g @kaitranntt/ccs

echo 'Link php'
echo '--------'
brew link --overwrite --force php@8.4

echo 'Install imagick'
echo '---------------'
pecl install imagick

echo 'Install memcached'
echo '-----------------'
pecl install memcached

echo 'Install xdebug'
echo '--------------'
pecl install xdebug

echo 'Install redis'
echo '-------------'
pecl install redis

echo 'Install laravel valet'
echo '---------------------'
composer global require laravel/valet
valet install

echo 'Install laravel/installer'
echo '-------------------------'
composer global require laravel/installer

echo 'Install artemeon/installer'
echo '--------------------------'
composer global require artemeon/installer

echo 'Install artemeon/mantis2github'
echo '------------------------------'
composer global require artemeon/mantis2github

echo 'Install bmitch/churn-php'
echo '------------------------'
composer global require bmitch/churn-php

echo 'Install povils/phpmnd'
echo '---------------------'
composer global require povils/phpmnd

echo 'Install rector/swiss-knife'
echo '--------------------------'
composer global require rector/swiss-knife

echo 'Install tomasvotruba/class-leak'
echo '-------------------------------'
composer global require tomasvotruba/class-leak

echo 'Install tomasvotruba/lines'
echo '--------------------------'
composer global require tomasvotruba/lines

echo 'Install maglnet/composer-require-checker'
echo '----------------------------------------'
composer global require maglnet/composer-require-checker

echo 'Install shipmonk/composer-dependency-analyser'
echo '---------------------------------------------'
composer global require shipmonk/composer-dependency-analyser

echo 'Enable Touch ID for sudo'
echo '------------------------'
sed 's/^#auth/auth/' /etc/pam.d/sudo_local.template | sudo tee /etc/pam.d/sudo_local > /dev/null

echo '++++++++++++++++++++++++++++++'
echo '++++++++++++++++++++++++++++++'
echo 'All done!'
echo 'Some optional tidbits'

echo '1. Set some sensible defaults by running: $HOME/.dotfiles/macos/set-defaults.sh'
echo '2. Make a ~/.dotfiles-custom/shell/.aliases for your personal commands'
echo '3. Install manually (no cask): Polyscope, Solo, HomeClaw, DoltWorkbench, Amphetamine (App Store), Glaze'

echo '++++++++++++++++++++++++++++++'
echo '++++++++++++++++++++++++++++++'

